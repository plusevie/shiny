#!/bin/bash
# managed by shiny-theme — SketchyBar config (bottom bar). Theme: {{THEME}}
# Edit templates/sketchybar/ in shiny instead; `shiny theme set` overwrites this.
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

sketchybar --bar position=bottom height={{BAR_HEIGHT}} margin={{WINDOW_GAP}} y_offset={{BAR_Y_OFFSET}} corner_radius=12 \
  color="$BAR_COLOR" border_color="$BAR_BORDER" border_width=1 \
  blur_radius="$BLUR" topmost=window shadow=off padding_left=6 padding_right=10

sketchybar --default \
  icon.font="SF Pro:Semibold:13.0" label.font="SF Pro:Semibold:13.0" \
  icon.color="$FG" label.color="$FG" \
  padding_left=4 padding_right=4 \
  icon.padding_left=4 icon.padding_right=4 label.padding_left=4 label.padding_right=4

# ── Workspaces (AeroSpace) ───────────────────────────────────────────────────
# A pill per workspace with windows, plus the focused one. Click to switch.
# AeroSpace triggers aerospace_workspace_change (templates/aerospace.toml).
sketchybar --add event aerospace_workspace_change
for sid in 1 2 3 4 5 6 7 8 9 A B C D E F G I M N O P Q R S T U V W X Y Z; do
  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change front_app_switched system_woke \
    --set space.$sid drawing=off \
    icon=$sid icon.padding_left=9 icon.padding_right=9 icon.color="$FG_DIM" \
    label.drawing=off padding_left=2 padding_right=2 \
    background.color="$PILL" background.corner_radius=8 background.height=22 \
    script="$PLUGIN_DIR/aerospace.sh $sid" click_script="aerospace workspace $sid"
done

sketchybar --add item front_app left --set front_app icon.drawing=off \
    label.color="$FG_DIM" padding_left=10 script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# ── Centre: Apple Music now playing (hidden when nothing plays) ─────────────
sketchybar --add item music center --set music drawing=off update_freq=5 \
    icon=􀑪 icon.color="$ACCENT" label.color="$FG_DIM" label.max_chars=48 \
    script="$PLUGIN_DIR/music.sh" \
  --subscribe music mouse.clicked

# ── Right (added right → left): clock, battery, wifi | Things, next event
sketchybar --add item clock right --set clock update_freq=15 icon.drawing=off \
    script="$PLUGIN_DIR/clock.sh" click_script="open -a Calendar" \
  --add item battery right --set battery update_freq=120 icon.color="$FG_DIM" label.drawing=off \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change \
  --add item wifi right --set wifi icon.color="$FG_DIM" label.drawing=off \
    update_freq=60 script="$PLUGIN_DIR/wifi.sh" \
  --subscribe wifi wifi_change system_woke

sketchybar --add item sep right --set sep icon="|" icon.color="$MUTED" label.drawing=off padding_left=2 padding_right=2 \
  --add item things right --set things icon=􀷾 icon.color="$ACCENT" update_freq=60 \
    script="$PLUGIN_DIR/things.sh" click_script="open -a Things3" \
  --add item calendar right --set calendar drawing=off update_freq=60 icon=􀉉 icon.color="$ACCENT" \
    label.color="$FG_DIM" label.max_chars=36 script="$PLUGIN_DIR/calendar.sh" click_script="open -a Calendar" \
  --subscribe calendar system_woke

# ── Hide during Mission Control ──────────────────────────────────────────────
# Mission Control lays windows out over the bar; shiny's patched borders posts
# these notifications when it opens/closes (libexec/borders-mc-notify.patch).
sketchybar --add event mc_enter shiny.missionControl.enter \
  --add event mc_exit shiny.missionControl.exit \
  --add item mission_control left --set mission_control drawing=off \
    script="$PLUGIN_DIR/mission_control.sh" \
  --subscribe mission_control mc_enter mc_exit

sketchybar --update
